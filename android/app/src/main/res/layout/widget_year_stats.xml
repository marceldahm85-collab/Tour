<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_year_stats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_year_stats_surface"
    android:clipToOutline="true"
    android:contentDescription="@string/widget_year_stats_description">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_alpine_background" />
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_year_stats_scrim" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <View
            android:id="@+id/widget_year_stats_accent_line"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#AD7D12" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/widget_year_stats_heading_icon"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_ic_ascent" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/widget_year_stats_heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.07"
                        android:text="BERGJAHR 2026"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.11"
                        android:text="DEINE JAHRESBILANZ"
                        android:textColor="#C9D3DB"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="#55FFFFFF" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/widget_year_stats_tours_icon"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_ic_tours" />
                    <TextView
                        android:id="@+id/widget_year_stats_tours_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="#FFFFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.08"
                        android:text="TOUREN"
                        android:textColor="#D5DEE5"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="48dp"
                    android:background="#44FFFFFF" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/widget_year_stats_distance_icon"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_ic_distance" />
                    <TextView
                        android:id="@+id/widget_year_stats_distance_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="0,0"
                        android:textColor="#FFFFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.08"
                        android:text="KILOMETER"
                        android:textColor="#D5DEE5"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <View
                    android:layout_width="1dp"
                    android:layout_height="48dp"
                    android:background="#44FFFFFF" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.15"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:id="@+id/widget_year_stats_ascent_icon"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_ic_ascent" />
                    <TextView
                        android:id="@+id/widget_year_stats_ascent_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="#FFFFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.08"
                        android:text="HÖHENMETER"
                        android:textColor="#D5DEE5"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
