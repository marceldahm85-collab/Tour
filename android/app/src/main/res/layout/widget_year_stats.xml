<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_year_stats_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_year_stats_surface"
    android:clipToOutline="true"
    android:contentDescription="@string/widget_year_stats_description">

    <ImageView
        android:id="@+id/widget_year_stats_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/widget_alpine_background" />

    <ImageView
        android:id="@+id/widget_year_stats_scrim_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_year_stats_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_year_stats_accent_line"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:contentDescription="@null"
            android:background="#AD7D12" />

        <!-- One-row layout: year plus the three core values. -->
        <LinearLayout
            android:id="@+id/widget_year_stats_compact"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/widget_year_stats_compact_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:letterSpacing="0.06"
                android:text="BERGJAHR 2026"
                android:textColor="#E8FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="2dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/widget_year_stats_compact_tours_group">
                    <ImageView
                        android:id="@+id/widget_year_stats_compact_tours_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_ic_tours" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/widget_year_stats_compact_tours_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:text="0"
                            android:textColor="#FFFFFFFF"
                            android:textSize="16sp"
                            android:gravity="start"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/widget_year_stats_compact_tours_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.04"
                            android:singleLine="true"
                            android:text="TOUREN"
                            android:textColor="#D5DEE5"
                            android:textSize="8sp"
                            android:gravity="start"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_year_stats_compact_divider_1"
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:background="#44FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/widget_year_stats_compact_distance_group">
                    <ImageView
                        android:id="@+id/widget_year_stats_compact_distance_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_ic_distance" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/widget_year_stats_compact_distance_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:text="0,0"
                            android:textColor="#FFFFFFFF"
                            android:textSize="16sp"
                            android:gravity="start"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/widget_year_stats_compact_distance_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.04"
                            android:singleLine="true"
                            android:text="KM"
                            android:textColor="#D5DEE5"
                            android:textSize="8sp"
                            android:gravity="start"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_year_stats_compact_divider_2"
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:background="#44FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/widget_year_stats_compact_ascent_group">
                    <ImageView
                        android:id="@+id/widget_year_stats_compact_ascent_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_ic_ascent" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/widget_year_stats_compact_ascent_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:text="0"
                            android:textColor="#FFFFFFFF"
                            android:textSize="16sp"
                            android:gravity="start"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/widget_year_stats_compact_ascent_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.04"
                            android:singleLine="true"
                            android:text="HM"
                            android:textColor="#D5DEE5"
                            android:textSize="8sp"
                            android:gravity="start"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Two-row layout: first row keeps the core metrics, second adds peaks, steps and walking time. -->
        <LinearLayout
            android:id="@+id/widget_year_stats_expanded"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/widget_year_stats_heading_icon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_ic_ascent" />
                <TextView
                    android:id="@+id/widget_year_stats_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.07"
                    android:text="BERGJAHR 2026"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:background="#55FFFFFF" />

            <LinearLayout
                android:id="@+id/widget_year_stats_expanded_first_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                        android:id="@+id/widget_year_stats_tours_group">
                    <ImageView
                        android:id="@+id/widget_year_stats_tours_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/widget_ic_tours" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/widget_year_stats_tours_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:text="0"
                            android:textColor="#FFFFFFFF"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/widget_year_stats_tours_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.04"
                            android:singleLine="true"
                            android:text="TOUREN"
                            android:textColor="#D5DEE5"
                            android:textSize="8sp"
                            android:gravity="center"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_year_stats_expanded_divider_1"
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:background="#44FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                        android:id="@+id/widget_year_stats_distance_group">
                    <ImageView
                        android:id="@+id/widget_year_stats_distance_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/widget_ic_distance" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/widget_year_stats_distance_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:text="0,0"
                            android:textColor="#FFFFFFFF"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/widget_year_stats_distance_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.04"
                            android:singleLine="true"
                            android:text="KILOMETER"
                            android:textColor="#D5DEE5"
                            android:textSize="8sp"
                            android:gravity="center"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_year_stats_expanded_divider_2"
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:background="#44FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                        android:id="@+id/widget_year_stats_ascent_group">
                    <ImageView
                        android:id="@+id/widget_year_stats_ascent_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/widget_ic_ascent" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/widget_year_stats_ascent_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:text="0"
                            android:textColor="#FFFFFFFF"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/widget_year_stats_ascent_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.04"
                            android:singleLine="true"
                            android:text="HÖHENMETER"
                            android:textColor="#D5DEE5"
                            android:textSize="8sp"
                            android:gravity="center"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_year_stats_expanded_row_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:contentDescription="@null"
                android:background="#55FFFFFF" />

            <LinearLayout
                android:id="@+id/widget_year_stats_expanded_second_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                        android:id="@+id/widget_year_stats_peaks_group">
                    <ImageView
                        android:id="@+id/widget_year_stats_peaks_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/widget_ic_peaks" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/widget_year_stats_peaks_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:text="0"
                            android:textColor="#FFFFFFFF"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/widget_year_stats_peaks_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.04"
                            android:singleLine="true"
                            android:text="GIPFEL"
                            android:textColor="#D5DEE5"
                            android:textSize="8sp"
                            android:gravity="center"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_year_stats_expanded_divider_4"
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:background="#44FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                        android:id="@+id/widget_year_stats_steps_group">
                    <ImageView
                        android:id="@+id/widget_year_stats_steps_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/widget_ic_steps" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/widget_year_stats_steps_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:text="0"
                            android:textColor="#FFFFFFFF"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/widget_year_stats_steps_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.04"
                            android:singleLine="true"
                            android:text="SCHRITTE"
                            android:textColor="#D5DEE5"
                            android:textSize="8sp"
                            android:gravity="center"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_year_stats_expanded_divider_5"
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:background="#44FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                        android:id="@+id/widget_year_stats_time_group">
                    <ImageView
                        android:id="@+id/widget_year_stats_time_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/widget_ic_time" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/widget_year_stats_time_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:text="0:00"
                            android:textColor="#FFFFFFFF"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/widget_year_stats_time_label"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.04"
                            android:singleLine="true"
                            android:text="GEHZEIT"
                            android:textColor="#D5DEE5"
                            android:textSize="8sp"
                            android:gravity="center"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
